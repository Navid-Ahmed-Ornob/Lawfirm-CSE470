# Copy this file to .env and adjust the values for your machine.

PORT=5000

# MySQL connection (defaults match a stock XAMPP install)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=law_firm
DB_TIMEZONE=+06:00

# Used to sign the login session cookie. Change this to any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
